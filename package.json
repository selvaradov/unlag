{
  "name": "unlag",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "plan": "node --experimental-strip-types scripts/print-plan.ts",
    "simulate": "node --experimental-strip-types scripts/print-plan.ts --json > analysis/plan.json && uv run --python 3.12 analysis/simulate.py",
    "fonts": "node scripts/copy-fonts.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@netlify/functions": "^6.0.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.4.1",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "lucide-static": "^1.41.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@netlify/blobs": "^11.0.3",
    "luxon": "^3.7.2",
    "web-push": "^3.6.7"
  }
}
